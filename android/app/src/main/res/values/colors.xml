<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        NexTelis brand palette — organized by role, not by hue name, so a
        future rebrand only ever means editing the hex values below, never
        hunting through layouts. See assets/NexTelis_Logo.png for source.

        Roles:
          brand_*     primary accent (from the logo's orange)
          surface_*   backgrounds/cards, dark theme (matches logo's black bg)
          text_*      on-surface text, by emphasis
          status_*    semantic states (success/warn/error)
    -->

    <!-- Brand / primary -->
    <color name="brand_primary">#F5821F</color>
    <color name="brand_primary_variant">#C9660F</color>
    <color name="brand_primary_on">#1A0D02</color>

    <!-- Surfaces -->
    <color name="surface_background">#0B0B0B</color>
    <color name="surface_card">#161616</color>
    <color name="surface_card_alt">#1F1F1F</color>
    <color name="surface_border">#2C2C2C</color>

    <!-- Text -->
    <color name="text_primary">#F7F7F7</color>
    <color name="text_secondary">#ABABAB</color>
    <color name="text_muted">#767676</color>

    <!-- Status -->
    <color name="status_good">#3FE07A</color>
    <color name="status_warn">#F2B84B</color>
    <color name="status_bad">#F2564B</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent">#00000000</color>
</resources>
