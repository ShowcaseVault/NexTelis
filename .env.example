# ── ENVIRONMENT ───────────────────────────────────────────
ENVIRONMENT=local

# ── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── ASTERISK ────────────────────────────────────────────────

ASTERISK_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASS=changeme

# ── Secrets ───────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=changeme

# ── Postgres ───────────────────────────────────────────────
POSTGRES_DB=nextelis
POSTGRES_USER=nextelis
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Backend connection string (host side)
DATABASE_URL=postgresql+asyncpg://nextelis:changeme@localhost:5433/nextelis

# ── SIP, as phones should reach it ─────────────────────────
# Reported to devices via /server/info and used verbatim to build their SIP
# account, so this must be routable FROM THE HANDSET — your machine's LAN IP
# or public domain, not localhost. Deliberately separate from the API
# address: the API can sit behind a reverse proxy or a tunnel, but SIP and
# RTP cannot traverse one.
SIP_HOST=192.168.1.13
SIP_PORT=5060
# udp (default), tcp, or tls. Signalling only — audio is RTP over UDP
# regardless. tcp holds the connection open, surviving NAT without
# re-registering. tls additionally encrypts signalling — requires a real
# hostname (not a bare IP) since certs can't be issued for one, plus
# SIP_TLS_CERT_ROOT_DIR below.
SIP_TRANSPORT=udp

# certbot's --config-dir (contains live/ and archive/ subdirs). Both are
# bind-mounted into the asterisk container, preserving certbot's relative
# symlink structure (live/<domain>/fullchain.pem -> ../../archive/<domain>/).
# Only used when SIP_TRANSPORT=tls. Get a cert with:
# certbot certonly --dns-cloudflare --dns-cloudflare-credentials <path> -d <SIP_HOST>
SIP_TLS_CERT_ROOT_DIR=/etc/letsencrypt
