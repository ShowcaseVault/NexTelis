# ── ENVIRONMENT ───────────────────────────────────────────
ENVIRONMENT=local

# ── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── ASTERISK ────────────────────────────────────────────────

ASTERISK_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASS=changeme

# ── Secrets ───────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=changeme

# ── Postgres ───────────────────────────────────────────────
POSTGRES_DB=nextelis
POSTGRES_USER=nextelis
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Backend connection string (host side)
DATABASE_URL=postgresql+asyncpg://nextelis:changeme@localhost:5433/nextelis

# Where devices should send SIP traffic, reported to them via /server/info.
# Only needed when the API is reachable at a different address than Asterisk —
# for example when the API is behind a reverse proxy or an HTTP tunnel such as
# ngrok. SIP is UDP on 5060 and RTP is UDP on high ports, so neither can
# traverse an HTTP tunnel; devices must reach Asterisk directly.
#
# Leave unset when the API and Asterisk share an address (the usual LAN setup)
# and devices will fall back to the API host.
# SIP_HOST=192.168.1.50
# SIP_PORT=5060
