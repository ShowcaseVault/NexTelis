# ── ENVIRONMENT ───────────────────────────────────────────
ENVIRONMENT=local

# ── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── ASTERISK ────────────────────────────────────────────────

ASTERISK_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASS=changeme

# ── Secrets ───────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=changeme

# ── Postgres ───────────────────────────────────────────────
POSTGRES_DB=nextelis
POSTGRES_USER=nextelis
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Backend connection string (host side)
DATABASE_URL=postgresql+asyncpg://nextelis:changeme@localhost:5433/nextelis

# ── SIP, as phones should reach it ─────────────────────────
# Reported to devices via /server/info and used verbatim to build their SIP
# account, so this must be routable FROM THE HANDSET — your machine's LAN IP,
# not localhost. Deliberately separate from the API address: the API can sit
# behind a reverse proxy or a tunnel, but SIP and RTP cannot traverse one.
SIP_HOST=192.168.1.13
SIP_PORT=5060
# udp (default) or tcp. Signalling only — audio is RTP over UDP either way.
# tcp holds the connection open, which survives NAT without re-registering.
SIP_TRANSPORT=udp
