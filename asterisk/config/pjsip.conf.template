[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

; TCP holds the connection open, so Asterisk can reach a device behind NAT
; without relying on UDP registration refreshes. Media is still RTP over UDP
; either way — this only affects signalling. Also the stepping stone to TLS.
[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060

; transport-tls is appended by entrypoint.sh, only when SIP_TLS_CERT_PATH and
; SIP_TLS_KEY_PATH are both set — see pjsip.conf.tls.template. Left out here
; unconditionally: pjsip.conf has no way to make a stanza optional, and
; loading transport-tls with an unset/unreadable cert fails Asterisk's
; startup with an ERROR for every system that hasn't provisioned one.

; Endpoints/auths/aors are realtime — served from Postgres (ps_endpoints,
; ps_auths, ps_aors) via res_config_odbc, see sorcery.conf/extconfig.conf.
; NexTelis backend writes those rows when a Number is assigned to a User.
; Test fixtures 9001/9002 are seeded by the Alembic migration
; eb5c725922c5_seed_two_hardcoded_test_users_for_.py.
